    "login": "/v1/auth/login",
    "browser_exchange": "/v1/auth/browser/exchange",
    "models": "/v1/client/models",
    "chat": "/v1/client/chat",
    "network": "/v1/notify-network",
    "mcp": "/v1/mcp"
  },
  "sharing": {
    "workspace_transport": "/v1/mcp/node/connect",
    "presence_transport": "/v1/notify-network",
    "handle_is_endpoint_address": true
  }
}
